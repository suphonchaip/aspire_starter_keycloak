@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using AspireApp.Web
@inject WeatherApiClient WeatherApi
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>หน้าหลัก</PageTitle>

<div class="container">
    <AuthorizeView>
        <Authorized Context="auth">
            <div class="hero-section">
                <MudCard Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h4">ยินดีต้อนรับ, @auth.User.Identity?.Name!</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body1">คุณได้เข้าสู่ระบบเรียบร้อยแล้ว</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted">
                            Authentication Type: @auth.User.Identity?.AuthenticationType
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </div>

            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5">ข้อมูลสภาพอากาศ</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Text" 
                                  Color="Color.Primary" 
                                  OnClick="LoadWeatherData"
                                  StartIcon="@Icons.Material.Filled.Refresh"
                                  Disabled="@isLoading">
                            @if (isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {
                                <span>รีเฟรช</span>
                            }
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (forecasts == null && isLoading)
                    {
                        <div class="d-flex align-center gap-2">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <MudText>กำลังโหลดข้อมูล...</MudText>
                        </div>
                    }
                    else if (forecasts == null && !isLoading)
                    {
                        <MudAlert Severity="Severity.Warning">
                            ยังไม่ได้โหลดข้อมูล กดปุ่มรีเฟรชเพื่อโหลดข้อมูล
                        </MudAlert>
                    }
                    else if (forecasts.Length == 0)
                    {
                        <MudAlert Severity="Severity.Info">ไม่พบข้อมูลสภาพอากาศ</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@forecasts" Hover="true" Striped="true">
                            <HeaderContent>
                                <MudTh>วันที่</MudTh>
                                <MudTh>อุณหภูมิ (°C)</MudTh>
                                <MudTh>อุณหภูมิ (°F)</MudTh>
                                <MudTh>สภาพอากาศ</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="forecast">
                                <MudTd DataLabel="วันที่">@forecast.Date.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="อุณหภูมิ (°C)">@forecast.TemperatureC</MudTd>
                                <MudTd DataLabel="อุณหภูมิ (°F)">@forecast.TemperatureF</MudTd>
                                <MudTd DataLabel="สภาพอากาศ">@forecast.Summary</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3">
                            <strong>ข้อผิดพลาด:</strong> @errorMessage
                        </MudAlert>
                    }
                    
                    @if (!string.IsNullOrEmpty(debugInfo))
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-3">
                            <strong>Debug Info:</strong> @debugInfo
                        </MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        </Authorized>
        <NotAuthorized>
            <div class="hero-section text-center">
                <MudCard Class="mx-auto" Style="max-width: 600px;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h3" Align="Align.Center">ยินดีต้อนรับสู่ AspireApp</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-4">
                            กรุณาเข้าสู่ระบบเพื่อดูข้อมูลสภาพอากาศ
                        </MudText>
                        
                        <div class="d-flex flex-column gap-3 align-center">
                            <MudButton Variant="Variant.Filled" 
                                      Color="Color.Primary" 
                                      Size="Size.Large"
                                      StartIcon="@Icons.Material.Filled.Login"
                                      Href="/login">
                                เข้าสู่ระบบ
                            </MudButton>
                            
                            <MudText Typo="Typo.caption" Class="text-muted">
                                หรือ
                            </MudText>
                            
                            <MudButton Variant="Variant.Outlined" 
                                      Color="Color.Secondary" 
                                      Size="Size.Medium"
                                      StartIcon="@Icons.Material.Filled.OpenInNew"
                                      Href="/authentication/login">
                                เข้าสู่ระบบผ่าน Keycloak
                            </MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private WeatherForecast[]? forecasts;
    private string errorMessage = "";
    private string debugInfo = "";
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // ไม่โหลดอัตโนมัติ ให้ผู้ใช้กดปุ่มรีเฟรช
            debugInfo = $"User authenticated: {user.Identity.Name}, Auth Type: {user.Identity.AuthenticationType}";
        }
    }

    private async Task LoadWeatherData()
    {
        isLoading = true;
        errorMessage = "";
        debugInfo = "";
        StateHasChanged();

        try
        {
            // ตรวจสอบ token ก่อนเรียก API
            var token = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "access_token");
            debugInfo = $"Token available: {!string.IsNullOrEmpty(token)}";
            
            if (!string.IsNullOrEmpty(token))
            {
                debugInfo += $", Token length: {token.Length}";
            }

            forecasts = await WeatherApi.GetWeatherAsync();
            debugInfo += ", API call successful";
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "ไม่มีสิทธิ์เข้าถึงข้อมูลสภาพอากาศ (401 Unauthorized)";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"เกิดข้อผิดพลาดในการเชื่อมต่อ: {ex.Message}";
            if (ex.Message.Contains("401"))
            {
                errorMessage += " - กรุณาตรวจสอบ token หรือเข้าสู่ระบบใหม่";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"เกิดข้อผิดพลาด: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
